# ========================================================
# DevPath Environment Configuration Template
# Duplicate this file as .env for custom local or Docker setups.
# NEVER commit actual passwords or tokens to version control.
# ========================================================

# Server Port
PORT=8085

# Active Spring Profile (dev = H2 in-memory/file zero-setup; prod = MySQL)
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration (used when SPRING_PROFILES_ACTIVE=prod or via Docker)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=devpath_db
DB_USER=devpath_user
DB_PASSWORD=devpath_secure_password
MYSQL_ROOT_PASSWORD=root_secure_password

# JWT Authentication Secret (Must be at least 256 bits / 32 characters in base64 or plaintext)
JWT_SECRET=c2VjdXJlLWRldnBhdGgtc3R1ZGVudC1wbGFjZW1lbnQtcG9ydGFsLWtleS0yMDI2
JWT_EXPIRATION_HOURS=24

# Application Information (Used by /api/health and demonstration endpoints)
APP_VERSION=1.0.0
BUILD_NUMBER=1
ENVIRONMENT=development
